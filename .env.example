DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used only by `npm run seed` to create the first admin account.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME=""

# Upstash Redis (rate limiting on the public referral endpoint)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile (bot protection on the referral form)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
