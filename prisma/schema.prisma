// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Customers (referrers). jobberCustomerId is nullable and unused in v1 —
// reserved so a future Jobber sync can populate it without a schema change.
// ---------------------------------------------------------------------------
model Customer {
  id               String   @id @default(uuid())
  jobberCustomerId String?  @unique
  referralCode     String   @unique
  firstName        String
  lastName         String
  email            String?
  phone            String?
  // When false, the public referral page stops accepting submissions for
  // this customer's link. Toggled from the admin dashboard; never deletes
  // the customer or their history.
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referrals Referral[]
  rewards   Reward[]

  @@index([jobberCustomerId])
}

enum ServiceType {
  HOUSE_WASHING
  WINDOW_CLEANING
  PRESSURE_WASHING
  GUTTER_CLEANING
  ROOF_WASHING
  OTHER
}

enum ReferralStatus {
  SUBMITTED
  CONTACTED
  ESTIMATE_SENT
  BOOKED
  JOB_COMPLETED
  REWARD_EARNED
  REWARD_PAID
}

model Referral {
  id       String @id @default(uuid())

  referrerId String
  referrer   Customer @relation(fields: [referrerId], references: [id])

  leadFirstName String
  leadLastName  String
  leadPhone     String
  leadEmail     String
  leadAddress   String
  leadCity      String
  leadZip       String

  serviceRequested ServiceType
  consentGiven     Boolean
  consentText      String

  status ReferralStatus @default(SUBMITTED)

  estimatedJobValue Decimal? @db.Decimal(10, 2)
  actualJobValue    Decimal? @db.Decimal(10, 2)

  // Reserved for a future Jobber sync — unused and unpopulated in v1.
  jobberClientId String?
  jobberQuoteId  String?
  jobberJobId    String?

  source            String  @default("referral_page")
  duplicateOfId     String?
  duplicateOf       Referral?  @relation("ReferralDuplicates", fields: [duplicateOfId], references: [id])
  duplicateReferrals Referral[] @relation("ReferralDuplicates")

  submittedIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ReferralEvent[]
  reward Reward?

  @@index([referrerId])
  @@index([status])
  @@index([leadPhone])
  @@index([leadEmail])
  @@index([createdAt])
}

enum ReferralEventType {
  STATUS_CHANGE
  NOTE
  JOBBER_SYNC
  NOTIFICATION_SENT
}

model ReferralEvent {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  eventType  ReferralEventType
  fromStatus ReferralStatus?
  toStatus   ReferralStatus?
  note       String?
  actor      String

  createdAt DateTime @default(now())

  @@index([referralId])
}

enum RewardType {
  SERVICE_CREDIT
  GIFT_CARD
}

enum RewardStatus {
  PENDING
  EARNED
  PAID
  VOIDED
}

model Reward {
  id         String   @id @default(uuid())
  referralId String   @unique
  referral   Referral @relation(fields: [referralId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  rewardType   RewardType
  rewardAmount Decimal    @db.Decimal(10, 2)
  status       RewardStatus @default(PENDING)

  earnedAt DateTime?
  paidAt   DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

enum AdminRole {
  OWNER
  ADMIN
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  // Deactivated admins cannot log in and are denied on their next
  // authenticated request even with a still-valid session cookie.
  isActive     Boolean   @default(true)
  // Set true after an OWNER resets this admin's password with "require
  // change on next login" — forces them through /admin/change-password
  // before they can use anything else.
  mustChangePassword Boolean @default(false)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  activityLogs ActivityLog[]
}

// Actions worth auditing across the admin dashboard. Deliberately excludes
// routine reads/page views — only state-changing actions land here.
enum ActivityAction {
  ADMIN_CREATED
  ADMIN_EDITED
  ADMIN_ROLE_CHANGED
  ADMIN_DEACTIVATED
  ADMIN_REACTIVATED
  ADMIN_PASSWORD_RESET
  ADMIN_DELETED
  CUSTOMER_CREATED
  CUSTOMER_DELETED
  CUSTOMER_LINK_DEACTIVATED
  CUSTOMER_LINK_REACTIVATED
  REFERRAL_STATUS_CHANGED
  REWARD_STATUS_CHANGED
  SETTINGS_CHANGED
}

// Append-only audit trail. adminId/adminName/adminEmail are captured at
// write time (not joined live) so a record always reads correctly even if
// the acting admin's name, email, or account is later changed — deleting an
// admin is blocked while they still have rows here (see the admin DELETE
// route), so this history can never be silently orphaned.
model ActivityLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminName  String
  adminEmail String

  action      ActivityAction
  targetType  String?
  targetId    String?
  description String
  // Safe before/after context only — never passwords, hashes, tokens, or
  // other secrets.
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// Single-row configuration table for the reward offer, editable from /admin/settings.
model ReferralSettings {
  id                       String   @id @default("singleton")
  referredDiscountAmount   Decimal  @default(25) @db.Decimal(10, 2)
  referrerCreditAmount     Decimal  @default(50) @db.Decimal(10, 2)
  referrerGiftCardAmount   Decimal  @default(25) @db.Decimal(10, 2)
  updatedAt                DateTime @updatedAt
  updatedByAdminId         String?
}
